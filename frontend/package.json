{
  "name": "copy-that-frontend",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest 'src/**/__tests__/hooks*.test.ts' --run",
    "test:integration": "vitest 'src/**/__tests__/*.integration.test.ts' --run",
    "test:components": "vitest 'src/**/__tests__/components*.test.ts' --run",
    "test:split": "pnpm run test:unit && pnpm run test:components && pnpm run test:integration",
    "test:hook-fix": "vitest 'src/components/overview-narrative/__tests__/hooks-tier1.test.ts' --run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "lucide-react": "^0.556.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^1.0.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.2.0",
    "vite": "^7.2.7",
    "vitest": "^1.0.0"
  }
}

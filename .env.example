# Copy That - Environment Configuration Template
# Copy this to .env.local, .env.staging, .env.production

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=local  # local | staging | production

# ============================================
# API CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Set to false in production
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# ============================================
# DATABASE (Loose Coupling - swap providers easily)
# ============================================
# Local Docker Postgres (recommended for offline/dev):
#   make db-bootstrap
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/copy_that

# Local SQLite smoke (no Docker): make db-bootstrap-sqlite
# DATABASE_URL=sqlite+aiosqlite:///./copy_that_local.db

# Neon.tech (hosted Postgres)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Staging / Production: Cloud SQL (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/project:region:instance

# ============================================
# STORAGE (Loose Coupling - local or cloud)
# ============================================
STORAGE_BACKEND=local  # local | gcs
LOCAL_STORAGE_PATH=./storage
GCS_BUCKET=copy-that-uploads
GCS_PROJECT_ID=copy-that-platform

# ============================================
# VISION/AI (Loose Coupling - swap providers)
# ============================================
VISION_BACKEND=gcp  # gcp | aws | azure | local
ML_BACKEND=vertex   # vertex | local | aws

# GCP Vision API
GCP_VISION_ENABLED=true

# Vertex AI
VERTEX_AI_PROJECT=copy-that-platform
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ENDPOINT_ID=

# Claude API (optional enhancement)
ANTHROPIC_API_KEY=

# OpenAI API (color extractors, cloud DALL·E for mood board images)
OPENAI_API_KEY=

# --------------------------------------------
# Mood board (parked P4) — local / cloud providers
# --------------------------------------------
# Text/themes: when TEXT_BASE_URL is set, use OpenAI-compatible chat (LM Studio).
# When unset, Anthropic Claude is used (requires ANTHROPIC_API_KEY).
# Load a chat model in LM Studio → Developer → Local Server (port 1234).
# Model ids must match what LM Studio lists at GET http://127.0.0.1:1234/v1/models
# (common local ids verified 2026-09-21):
# MOOD_BOARD_TEXT_BASE_URL=http://127.0.0.1:1234/v1
# MOOD_BOARD_TEXT_API_KEY=lm-studio
# MOOD_BOARD_TEXT_MODEL=google/gemma-4-e4b
# Prefer for theme JSON (faster / more reliable structured output):
# MOOD_BOARD_TEXT_MODEL=google/gemma-2-9b
# Heavier: liquid/lfm2-24b-a2b
# Note: gemma-4-e4b may stall on long mood-board JSON prompts; use gemma-2-9b for dogfood.

# Images: OpenAI-compatible images.generate → local Apple Silicon shim
#   uv run --with mflux --with pillow python scripts/mood_board_local_image_server.py
# Default Hub mirror (4-bit schnell). Script defaults match these when unset:
# MOOD_BOARD_LOCAL_IMAGE_MODEL=dhairyashil/FLUX.1-schnell-mflux-4bit
# MOOD_BOARD_LOCAL_IMAGE_BASE_MODEL=schnell
# Fallback: MOOD_BOARD_LOCAL_IMAGE_MODEL=schnell  (mflux downloads + quantizes BFL weights)
# Z-Image-Turbo is NOT the default (opt-in only; very large).
# HF_TOKEN=hf_…   # optional; set if Hub rate-limits or you use gated weights
# MOOD_BOARD_LOCAL_IMAGE_QUANTIZE=4
# MOOD_BOARD_LOCAL_IMAGE_STEPS=4
# MOOD_BOARD_IMAGE_BASE_URL=http://127.0.0.1:8765/v1
# MOOD_BOARD_IMAGE_API_KEY=local
# MOOD_BOARD_IMAGE_MODEL=schnell
# MOOD_BOARD_IMAGE_SIZE=1024x1024
#
# Footnote (not primary on Mac): A1111/Forge → scripts/mood_board_a1111_openai_shim.py
# When IMAGE_BASE_URL unset and OPENAI_API_KEY set → cloud DALL·E 3. Else skip images.

# Celery queue for mood board jobs (optional override)
# CELERY_MOOD_BOARD_QUEUE=mood-board

# ============================================
# AUTHENTICATION & SECURITY (SaaS essentials)
# ============================================
SECRET_KEY=your-secret-key-change-in-production  # REQUIRED: override in all environments
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 (for SaaS social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# CACHING & QUEUE (SaaS performance)
# ============================================
# Local Development: Local Redis (docker-compose)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Production/Staging: Upstash Redis (configured in GCP Secret Manager)
# Get from GCP: gcloud secrets versions access latest --secret="redis-url"
# REDIS_URL=redis://default:xxx@literate-javelin-39380.upstash.io:6379
# CELERY_BROKER_URL=redis://default:xxx@literate-javelin-39380.upstash.io:6379
# CELERY_RESULT_BACKEND=redis://default:xxx@literate-javelin-39380.upstash.io:6379

# Alternative: GCP Memorystore (more expensive)
# REDIS_URL=redis://10.x.x.x:6379/0

# ============================================
# MONITORING & OBSERVABILITY (SaaS critical)
# ============================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================
# RATE LIMITING (SaaS protection)
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# MULTI-TENANCY (SaaS architecture)
# ============================================
TENANT_ISOLATION_STRATEGY=schema  # schema | row | database
MAX_TENANTS_PER_INSTANCE=100

# ============================================
# BILLING & SUBSCRIPTIONS (Future SaaS)
# ============================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
FREE_TIER_LIMIT=10  # Extractions per month
PRO_TIER_LIMIT=1000
ENTERPRISE_TIER_LIMIT=-1  # Unlimited

{
  "name": "copy-that",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "type-check": "pnpm --dir frontend type-check",
    "lint": "pnpm --dir frontend lint",
    "lint:fix": "pnpm --dir frontend exec eslint . --fix",
    "test": "pnpm --dir frontend test",
    "test:run": "pnpm --dir frontend exec vitest --run",
    "test:ui": "pnpm --dir frontend exec vitest --ui",
    "test:coverage": "pnpm --dir frontend exec vitest --coverage",
    "test:store": "pnpm --dir frontend exec vitest --run src/store",
    "test:config": "pnpm --dir frontend exec vitest --run src/config",
    "test:components": "pnpm --dir frontend exec vitest --run src/components/__tests__",
    "test:e2e": "playwright test -c frontend/playwright.config.ts",
    "test:e2e:ui": "playwright test -c frontend/playwright.config.ts --ui",
    "test:e2e:mvp": "PLAYWRIGHT_USE_MOCKS=true playwright test -c frontend/playwright.config.ts mvp-phase1-smoke overview-shape-polish ui_redundancy tabs_layout visual-contracts",
    "test:e2e:evidence": "PLAYWRIGHT_USE_MOCKS=true PLAYWRIGHT_CAPTURE_EVIDENCE=true playwright test -c frontend/playwright.config.ts evidence-screens",
    "ui:report": "PLAYWRIGHT_SCREENSHOT=on pnpm test:e2e -- frontend/tests/playwright/overview_mobile_layout.spec.ts frontend/tests/playwright/token-data-points.spec.ts && node scripts/generate_ui_report.js",
    "ui:report:pr": "UI_REPORT_MODE=pr UI_REPORT_BASE_REF=origin/main pnpm ui:report",
    "test:fast": "pnpm --dir frontend exec vitest --run src/store src/config",
    "test:all": "pnpm --dir frontend exec vitest --run",
    "test:split": "pnpm --dir frontend run test:split"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
